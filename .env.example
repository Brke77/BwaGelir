# Supabase Dashboard > Connect: Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase Dashboard > Settings > API Keys > Publishable key (sb_publishable_...)
# Legacy anon key is also supported. Never use service_role / secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local: http://localhost:3000 | Production: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
